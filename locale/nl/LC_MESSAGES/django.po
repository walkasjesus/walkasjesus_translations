msgstr "#5 Is het nieuwe verbond al helemaal vervuld? - Jeremia 31"

#: walkasjesus_app/templates/commandments/legalism.html:45
msgid "#6 - Freedom or Lawlessness? - Ephesians 2:8-10"
msgstr "#6 Vrijheid of wetteloosheid? - Efeziërs 2:8-10"

#: walkasjesus_app/templates/commandments/legalism.html:46
msgid "#7a - Do we by faith make void the law? - Romans 1-4"
msgstr "#7a Doen wij door het geloof de wet teniet? - Romeinen 1-4"

#: walkasjesus_app/templates/commandments/legalism.html:47
msgid "#7b - Not under law but under grace - Romans 5-7"
msgstr "#7b Niet onder de wet maar onder de genade - Romeinen 5-7"

#: walkasjesus_app/templates/commandments/legalism.html:48
msgid "#7c - The law of God and the law of sin - Romans 7-8"
msgstr "#7c De wet van God en de wet van de zonde - Romeinen 7-8"

#: walkasjesus_app/templates/commandments/legalism.html:49
msgid "#7d - Christ the end of the law - Romans 9-10"
msgstr "#7d Christus het einde van de wet - Romeinen 9-10"

#: walkasjesus_app/templates/commandments/legalism.html:50
msgid "#7e - Are there differences between Jews and Gentiles? - Rom 11-12"
msgstr "#7e Zijn er verschillen tussen Joden en Heidenen? - Rom 11-12"

#: walkasjesus_app/templates/commandments/legalism.html:51
msgid "#7f - Boundaries.. - Rom 11-12"
msgstr "#7f Grenzen.. - Rom 11-12"

#: walkasjesus_app/templates/commandments/legalism.html:52
msgid "#8a - Died by the Law to the Law - Galatians 1-2"
msgstr "#8a Door de wet voor de wet gestorven - Galaten 1-2"

#: walkasjesus_app/templates/commandments/legalism.html:53
msgid "#8b - The Law as Our Tutor TO Christ - Galatians 3"
msgstr "#8b De wet als onze leermeester TOT Christus - Galaten 3"

#: walkasjesus_app/templates/commandments/legalism.html:54
msgid "#8c - So fulfill the law of Christ - Galatians 4-6"
msgstr "#8c Vervul zo de wet van Christus - Galaten 4-6"

#: walkasjesus_app/templates/commandments/legalism.html:55
msgid "#9 - For Jews a Jew, for Greeks a Greek?! - 1 Cor 7-9"
msgstr "#9 Voor Joden een Jood, voor Grieken een Griek?! - 1 Kor 7-9"

#: walkasjesus_app/templates/commandments/legalism.html:56
