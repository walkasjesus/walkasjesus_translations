#: walkasjesus_app/templates/lessons/detail.html:653
#: walkasjesus_app/templates/lessons/lesson_listing.html:92
#: walkasjesus_app/templates/lessons/lesson_listing.html:139
#: walkasjesus_app/templates/lessons/lesson_listing.html:180
#: walkasjesus_app/templates/lessons/lesson_listing.html:225
